// schema.prisma — full updated file

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model History {
  id             String   @id @default(cuid())
  productId      String
  productTitle   String
  description    String
  vibe           String
  format         String
  keywords       String?
  includeSocials Boolean
  socials        Json?
  createdAt      DateTime @default(now())
}

model GenerationJob {
  id                  String   @id @default(uuid())
  shopDomain          String
  productId           String
  status              String
  inputHash           String
  vibe                String
  format              String
  keywords            String
  includeSocials      Boolean
  result              Json?
  errorMessage        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  bulkId              String?
  bullJobId           String?
  costTokens          Int      @default(0)
  productTitle        String
  progress            Int      @default(0)
  traceId             String?

  // Description snapshot fields — added for undo support
  generatedDescription String?  // The AI-generated description written to Shopify
  previousDescription  String?  // Snapshot of the product description BEFORE generation

  @@index([shopDomain])
  @@index([productId])
  @@index([status])
}
