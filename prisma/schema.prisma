// schema.prisma — full updated file

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model History {
  id             String   @id @default(cuid())
  shopDomain     String   @default("")
  productId      String
  productTitle   String
  description    String
  vibe           String
  format         String
  keywords       String?
  includeSocials Boolean
  socials        Json?
  createdAt      DateTime @default(now())
}

model GenerationJob {
  isStale Boolean @default(false)
  id                  String   @id @default(uuid())
  shopDomain          String
  productId           String
  status              String
  inputHash           String
  vibe                String
  format              String
  keywords            String
  includeSocials      Boolean
  result              Json?
  errorMessage        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  bulkId              String?
  bullJobId           String?
  costTokens          Int      @default(0)
  productTitle        String
  progress            Int      @default(0)
  traceId             String?
  customInstruction String? 
  // Description snapshot fields — added for undo support
  generatedDescription String?  // The AI-generated description written to Shopify
  previousDescription  String?  // Snapshot of the product description BEFORE generation
  productVendor   String?
  productType     String?
  productTags     String?

  @@index([shopDomain])
  @@index([productId])
  @@index([status])
}
// Tracks per-shop monthly credit usage
model ShopCreditUsage {
  id            String   @id @default(cuid())
  shopDomain    String
  billingPeriod String   // e.g. "2025-03"
  creditsUsed   Float    @default(0)
  plan          String   @default("free")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([shopDomain, billingPeriod])
  @@index([shopDomain])
  @@index([billingPeriod])
}

// Global monthly credit usage
model GlobalCreditUsage {
  id            String   @id @default(cuid())
  billingPeriod String   // e.g. "2025-03"
  creditsUsed   Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([billingPeriod])
  @@index([billingPeriod])
}

model CustomTemplate {
  id          String   @id @default(cuid())
  shopDomain  String
  name        String           // e.g. "My Beach Vibes"
  instruction String           // e.g. "Write in a fun surfer tone, use emojis..."
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shopDomain])
}